const url = require('url');

const MOCK_MOUNT = '/_mock/__MODULE_KEY__/';

function sendJson(res, statusCode, body) {
  res.statusCode = statusCode;
  res.setHeader('Content-Type', 'application/json;charset=utf-8');
  res.end(JSON.stringify(body));
}

function handleMockError(res, error) {
  if (error instanceof SyntaxError) {
    sendJson(res, 400, { message: '请求体不是合法 JSON' });
    return;
  }

  sendJson(res, 500, { message: error && error.message ? error.message : 'Mock 服务异常' });
}

function readJsonBody(req) {
  if (req.body && typeof req.body === 'object') {
    return Promise.resolve(req.body);
  }

  return new Promise((resolve, reject) => {
    const chunks = [];

    req.on('data', (chunk) => chunks.push(chunk));
    req.on('error', reject);
    req.on('end', () => {
      const raw = Buffer.concat(chunks).toString('utf8').trim();
      if (!raw) {
        resolve({});
        return;
      }

      try {
        resolve(JSON.parse(raw));
      } catch (error) {
        reject(error);
      }
    });
  });
}

function parseMockRequestPath(pathname) {
  if (!pathname.startsWith(MOCK_MOUNT)) {
    return null;
  }

  const relativePath = pathname.slice(MOCK_MOUNT.length - 1) || '/';
  const segments = relativePath.split('/').filter(Boolean);
  const organizationId = segments[0] === 'v1' ? segments[1] : undefined;

  return {
    relativePath,
    matchedVersion: segments[0] === 'v1' && Boolean(organizationId),
    organizationId,
    resourceSegments: segments.slice(2),
  };
}

